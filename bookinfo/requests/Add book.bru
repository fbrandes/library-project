meta {
  name: Add book
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "isbn": "{{isbn}}",
    "title": "Effective Java",
    "author": "Joshua Bloch",
    "pages": 416
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("bookUuid", res.body.id);
  }
}
