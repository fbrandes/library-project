meta {
  name: Add book
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/books
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "isbn": "{{isbn}}",
    "title": "{{$randomWords}}",
    "author": {
      "firstname": "{{$randomFirstName}}",
      "middlename": "",
      "lastname": "{{$randomLastName}}",
      "bio": "{{$randomLoremParagraph}}"
    },
    "pages": {{$randomInt}},
    "publisher": {
      "name": "{{$randomCompanyName}}",
      "address": {
        "street": "{{$randomStreetName}}",
        "zipCode": "{{$randomInt}}",
        "city": "{{$randomCity}}"
      }
    },
    "genres": {{genres}},
    "language": "English",
    "summary": "{{$randomLoremParagraph}}",
    "publicationDate": "{{publicationDate}}",
    "edition": {{edition}},
    "type": "{{type}}"
  }

}

script:pre-request {
  function randomDigits(length) {
    return Array.from({ length }, () => Math.floor(Math.random() * 10)).join("");
  }

  function randomChoice(values) {
    return values[Math.floor(Math.random() * values.length)];
  }

  function isbn13CheckDigit(first12Digits) {
    const sum = [...first12Digits].reduce((total, digit, index) => {
      return total + Number(digit) * (index % 2 === 0 ? 1 : 3);
    }, 0);

    return String((10 - (sum % 10)) % 10);
  }

  function randomDashedIsbn13() {
    const prefix = randomChoice(["978", "979"]);

    const group = randomChoice([
      "0", "1", "2", "3", "4", "5", "7",
      "80", "83", "84", "85", "88", "89",
      "90", "91", "92", "93", "94", "95", "96"
    ]);

    const remainingLength = 12 - prefix.length - group.length;

    const registrantLength = Math.max(2, Math.floor(remainingLength / 2));
    const publicationLength = remainingLength - registrantLength;

    const registrant = randomDigits(registrantLength);
    const publication = randomDigits(publicationLength);

    const first12Digits = prefix + group + registrant + publication;
    const checkDigit = isbn13CheckDigit(first12Digits);

    return `${prefix}-${group}-${registrant}-${publication}-${checkDigit}`;
  }

  function randomIntBetween(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function randomGenres() {
    const availableGenres = [
      "Fantasy",
      "Science Fiction",
      "Mystery",
      "Thriller",
      "Romance",
      "Historical Fiction",
      "Horror",
      "Biography",
      "Nonfiction",
      "Young Adult"
    ];

    const amount = randomIntBetween(1, 3);
    const shuffled = [...availableGenres].sort(() => Math.random() - 0.5);

    return shuffled.slice(0, amount);
  }
  function randomDateString(startYear = 1950, endYear = 2026) {
    const start = new Date(`${startYear}-01-01T00:00:00Z`);
    const end = new Date(`${endYear}-12-31T00:00:00Z`);

    const randomTime =
      start.getTime() + Math.random() * (end.getTime() - start.getTime());

    return new Date(randomTime).toISOString().slice(0, 10);
  }

  bru.setVar("publicationDate", randomDateString());
  bru.setVar("genres", JSON.stringify(randomGenres()));
  bru.setVar("isbn", randomDashedIsbn13());
  bru.setVar("edition", randomIntBetween(1, 3))
  bru.setVar("type", randomChoice(['HARDCOVER', 'SOFTCOVER', 'EBOOK']))
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("bookUuid", res.body.id);
  }
}
