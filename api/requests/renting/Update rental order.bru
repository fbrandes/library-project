meta {
  name: Update rental order
  type: http
  seq: 14
}

put {
  url: {{rentingBaseUrl}}/orders/:uuid
  body: json
  auth: none
}

params:path {
  uuid: {{orderUuid}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "userId": "{{rentingUserId}}",
    "contents": [
      {
        "isbn": "{{rentingIsbn}}",
        "title": "Effective Go Services",
        "author": {
          "firstname": "Ada",
          "middlename": "",
          "lastname": "Lovelace",
          "bio": "Computer pioneer and technical author."
        },
        "pages": 300,
        "publisher": {
          "name": "Engineering Press",
          "address": {
            "street": "Main Street 1",
            "zipCode": "02116",
            "city": "Boston"
          }
        },
        "genres": ["Programming", "Software Engineering"],
        "language": "English",
        "summary": "A practical guide to building Go services.",
        "publicationDate": "2026-01-01",
        "edition": 1,
        "type": "HARDCOVER"
      }
    ],
    "state": "READY_FOR_PICKUP"
  }
}
