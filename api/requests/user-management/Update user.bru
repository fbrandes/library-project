meta {
  name: Update user
  type: http
  seq: 22
}

put {
  url: {{userManagementBaseUrl}}/users/:id
  body: json
  auth: none
}

params:path {
  id: {{userManagementUserId}}
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "ada.user@example.com",
    "firstName": "Ada",
    "lastName": "Byron",
    "role": "ADMIN",
    "status": "INACTIVE"
  }
}
