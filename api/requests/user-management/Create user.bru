meta {
  name: Create user
  type: http
  seq: 20
}

post {
  url: {{userManagementBaseUrl}}/users
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "ada.user@example.com",
    "firstName": "Ada",
    "lastName": "Lovelace",
    "role": "LIBRARIAN",
    "status": "ACTIVE"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("userManagementUserId", res.body.id);
  }
}
