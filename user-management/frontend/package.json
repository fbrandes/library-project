{
    "name": "user-management-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@11.7.0",
    "scripts": {
        "build": "pnpm generate:models && tsc -p tsconfig.app.json && vite build",
        "coverage": "vitest run --coverage",
        "dev": "vite --host 0.0.0.0",
        "generate:models": "node ../scripts/generate-models.mjs",
        "lint:fix": "eslint --quiet --fix",
        "lint:format": "prettier  --log-level warn --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\" ",
        "lint": "pnpm run lint:format && pnpm run lint:fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest"
    },
    "dependencies": {
        "vue": "3.5.40",
        "vue-material": "1.0.0-beta-16"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.0",
        "@types/node": "^26.1.1",
        "@vitejs/plugin-vue2": "^2.3.3",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "esbuild": "^0.28.1",
        "jsdom": "^29.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "vue-template-compiler": "2.7.16"
    }
}
