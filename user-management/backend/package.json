{
  "name": "user-management-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "generate:models": "node ../scripts/generate-models.mjs",
    "build": "pnpm generate:models && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "USER_MANAGEMENT_TESTCONTAINERS=true vitest run src/users/postgres-users.repository.integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.9.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.9",
    "testcontainers": "^11.9.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
