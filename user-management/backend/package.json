{
  "name": "user-management-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
      "build": "pnpm generate:models && tsc -p tsconfig.build.json",
      "generate:models": "node ../scripts/generate-models.mjs",
      "coverage": "vitest run --coverage",
      "lint:fix": "eslint ./src --quiet --fix",
      "lint:format": "prettier  --log-level warn --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\" ",
      "lint": "npm run lint:format && npm run lint:fix",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "USER_MANAGEMENT_TESTCONTAINERS=true vitest run src/users/postgres-users.repository.integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.10",
    "testcontainers": "^12.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
